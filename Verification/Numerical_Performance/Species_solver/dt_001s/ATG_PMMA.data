//

&GPYRO_GENERAL 
DT0 = 0.01,
CONVENTIONAL_RXN_ORDER = .FALSE.
 / 


&GPYRO_OUTPUT 
CASENAME = 'ATG_PMMA' ,
N_POINT_QUANTITIES = 4,
N_PROFILE_QUANTITIES = 0,

DTDUMP_POINT = 10,

POINT_QUANTITY(1) = 'TEMPERATURE', 
POINT_QUANTITY_INDEX(1) = 0, 
POINT_Z(1)=0
POINT_QUANTITY(2) = 'MLR', 
POINT_QUANTITY_INDEX(2) = 0, 
POINT_Z(2)=0
POINT_QUANTITY(3) = 'YI',
POINT_QUANTITY_INDEX(3) = 1,

POINT_QUANTITY(4) = 'REACTION_RATE_K',
POINT_QUANTITY_INDEX(4) = 1,
 / 

&GPYRO_SPROPS NSSPEC = 1,
   NAME(1) = 'PMMA' , R0(1) = 1000, 
/ 

&GPYRO_GPROPS NGSPEC = 1, 
  NAME(1) = 'gas1' 
 /

&GPYRO_RXNS 
NRXNS = 1, 
CFROM(1) = 'PMMA' ,
CTO(1)   = 'gases' ,
Z(1)     =  8.7E+12 ,
E(1)     = 163 ,
ORDER(1) = 1,
CHI(1)   = 1 ,
/



&GPYRO_GYIELDS 
GYIELDS(1,1) = 1, 
 /


&GPYRO_CASES NCASES = 1, 
IMESH(1) = 1, 
TSTOP(1) = 5000, 
ZEROD(1) = .TRUE., 
BETA(1)  = 5, 
 /


&GPYRO_IC 
NIC = 1, 
TMP_INITIAL(1) = 300, 
TMPG_INITIAL(1) = 300, 
P_INITIAL(1) = 101300, 
YI0(1,1) = 1,   
YJ0(1,1) = 1,
/



&GPYRO_GEOM 
NMESH = 1, 
NCELLZ(1) = 1, 
NCELLY(1) = 1, 
NCELLX(1) = 1, 
DEFAULT_IC(1) = 1, 

 /

