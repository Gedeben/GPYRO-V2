//
&GPYRO_GENERAL 
DT0 = 1,
TAMB = 300,
TREF = 300,
P0 = 101300,

NTDMA_ITERATIONS = 1000,
ALPHA = 1,
YJTOL = 0.00000001,
SOLVE_GAS_YJ   = .TRUE.,
SOLVE_PRESSURE = .FALSE.,
 / 

&GPYRO_OUTPUT 
CASENAME = 'gas_diffusion',
N_POINT_QUANTITIES = 1,
N_PROFILE_QUANTITIES = 3,
N_SMOKEVIEW_QUANTITIES = 0,
DTDUMP_POINT = 1, DTDUMP_PROFILE = 1,

POINT_QUANTITY(1) = 'N_ITERATIONS', 


PROFILE_QUANTITY(1) = 'YJ', PROFILE_QUANTITY_INDEX(1) = 1, 
PROFILE_QUANTITY(2) = 'YJ', PROFILE_QUANTITY_INDEX(2) = 2, 
PROFILE_QUANTITY(3) = 'D12', 


 / 
 
&GPYRO_SPROPS 
NSSPEC = 1, 
NAME(1) = 'wood', K0Z(1) = 0.2, RS0(1) = 1000, R0(1) = 400, C0(1) = 1200, EMIS(1) = 1, PERMZ(1) = 1D-10, 
 / 

&GPYRO_RXNS NRXNS = 0 /
&GPYRO_HGRXNS NHGRXNS = 0/

&GPYRO_GPROPS NGSPEC = 2, 
IBG = 1, IO2 = 2, CPG = 1000, 
NAME(1) = 'oxygen'  , M(1) = 32 , SIGMA(1) = 3.433, EPSOK(1) = 113 , 
NAME(2) = 'nitrogen', M(2) = 32 , SIGMA(2) = 3.681, EPSOK(2) = 91.5 /

&GPYRO_GYIELDS 
GYIELDS(1,1) = 1, 
 /

&GPYRO_HGYIELDS 
 /

&GPYRO_CASES NCASES = 1, 
IMESH(1) = 1, TSTOP(1) = 2000/

&GPYRO_IC NIC = 2, 
TMP_INITIAL(1) = 300, TMPG_INITIAL(1) = 300, P_INITIAL(1) = 101300, YI0(1,1) = 1, YJ0(1,1) = 0  , YJ0(1,2) = 1,
TMP_INITIAL(2) = 300, TMPG_INITIAL(2) = 300, P_INITIAL(2) = 101300, YI0(2,1) = 1, YJ0(2,1) = 0.4, YJ0(2,2) = 0.6,
/

&GPYRO_ALLBC NSURF_IDX = 2, 
SURF_IDX(1) = 1, 
QE(1) = 0, HC(1) = 0, TINF(1) = 300, RERADIATION(1) = .FALSE.,
HM(1) = 0.0001,  YJINF(1,1) = 0.22, YJINF(1,2) = 0.78,

SURF_IDX(2) = 2, 
QE(2) = 0, HC(2) = 0, TINF(2) = 300, RERADIATION(2) = .FALSE.,
HM(2) = 0, YJINF(2,1) = 0.22,YJINF(2,2) = 0.78,
/

&GPYRO_GEOM 
NMESH = 1, NOBST = 0, 
ZDIM(1) = 1, XDIM(1) = 1, YDIM(1) = 1, NCELLZ(1) = 201, NCELLX(1) = 1, NCELLY(1) = 1, 
DEFAULT_SURF_IDX(1,5) = 1, DEFAULT_SURF_IDX(1,6) = 2, DEFAULT_IC(1) = 1, 
 /


