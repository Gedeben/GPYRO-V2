//
&GPYRO_GENERAL 
DT0 = 1/ 

&GPYRO_OUTPUT 
CASENAME = 'gas_transport' ,
N_POINT_QUANTITIES = 5, N_PROFILE_QUANTITIES = 3,DTDUMP_POINT = 1,
POINT_QUANTITY(1) = 'TEMPERATURE', 
POINT_QUANTITY(2) = 'YI'   ,POINT_QUANTITY_INDEX(2) = 1, 
POINT_QUANTITY(3) = 'YI'   ,POINT_QUANTITY_INDEX(3) = 2,
POINT_QUANTITY(4) = 'MLR'  ,POINT_QUANTITY_INDEX(4) = 0,
POINT_QUANTITY(5) = 'MASS_FLUX_TOTAL_Z'
PROFILE_QUANTITY(1) = 'MASS_FLUX_TOTAL_Z'
PROFILE_QUANTITY(2) = 'QSG'
PROFILE_QUANTITY(3) = 'TEMPERATURE'/ 

&GPYRO_SPROPS NSSPEC = 2,
NAME(1) = 'MAT_A', K0Z(1) = 0.2, R0(1) = 1000, C0(1) = 1800, EMIS(1) = 1, 
NAME(2) = 'MAT_B', K0Z(2) = 0.2, R0(2) = 600 , C0(2) = 1800, EMIS(2) = 1 / 

&GPYRO_GPROPS NGSPEC = 1, NAME(1) = 'gas1', CPG=1000 /

&GPYRO_RXNS NRXNS = 1, 
CFROM(1) = 'MAT_A', CTO(1) = 'MAT_B', Z(1)= 0.001 , E(1)= 0, ORDER(1) = 0, CHI(1)= 1/

&GPYRO_GYIELDS GYIELDS(1,1) = 1/

&GPYRO_CASES NCASES = 1, TSTOP(1) = 1500 /

&GPYRO_IC NIC = 1, TMP_INITIAL(1) = 300, YI0(1,1) = 1,   YJ0(1,1) = 1,/

&GPYRO_ALLBC NSURF_IDX = 2, 
SURF_IDX(1) = 1, T(1) = 0, QE(1) = 0, HC(1) = 0, TINF(1) = 300, RERADIATION(1) = .FALSE., YJINF(1,1) = 1,MDOTPP(1)=100,
SURF_IDX(2) = 2, T(2) = 0, QE(2) = 0, HC(2) = 0, TINF(2) = 300, RERADIATION(2) = .FALSE., YJINF(2,1) = 1,MDOTPP(2)=0,/

&GPYRO_GEOM NMESH = 1, 
ZDIM(1) = 0.1, NCELLZ(1) = 100, NCELLY(1) = 1, NCELLX(1) = 1, 
DEFAULT_IC(1) = 1, DEFAULT_SURF_IDX(1,5) = 2, DEFAULT_SURF_IDX(1,6) = 1 /

