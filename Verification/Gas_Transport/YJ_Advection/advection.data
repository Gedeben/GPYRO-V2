//
&GPYRO_GENERAL 
DT0 = 0.01,
TAMB = 300,
TREF = 300,
P0 = 101300,

NTDMA_ITERATIONS = 1000,
ALPHA = 1,
YJTOL = 0.00000001,
SOLVE_GAS_YJ   = .TRUE.,
SOLVE_PRESSURE = .FALSE.,
CONV_DIFF_SCHEME=3
 / 

&GPYRO_OUTPUT 
CASENAME = 'gas_advection',
N_POINT_QUANTITIES = 1,
N_PROFILE_QUANTITIES = 6,
N_SMOKEVIEW_QUANTITIES = 0,
DTDUMP_POINT = 0.1, DTDUMP_PROFILE = 0.1,

POINT_QUANTITY(1) = 'N_ITERATIONS', 


PROFILE_QUANTITY(1) = 'YJ', PROFILE_QUANTITY_INDEX(1) = 1, 
PROFILE_QUANTITY(2) = 'YJ', PROFILE_QUANTITY_INDEX(2) = 2, 
PROFILE_QUANTITY(3) = 'TEMPERATURE', 
PROFILE_QUANTITY(4) = 'MASS_FLUX_TOTAL_Z', 
PROFILE_QUANTITY(5) = 'D12', 
PROFILE_QUANTITY(6) = 'GAS_DENSITY', 
 / 
 
&GPYRO_SPROPS 
NSSPEC = 1, 
NAME(1) = 'wood', K0Z(1) = 0.2, RS0(1) = 1000, R0(1) = 400, C0(1) = 1200, EMIS(1) = 1, PERMZ(1) = 1D-10, 
 / 

&GPYRO_RXNS NRXNS = 1
CFROM(1) = 'wood', CTO(1) = 'gases', Z(1)= 1E+20 , E(1)= 2000, ORDER(1) = 1, CHI(1)= 1/

&GPYRO_HGRXNS NHGRXNS = 0/

&GPYRO_GPROPS NGSPEC = 2, 
IBG = 1, IO2 = 2, CPG = 1000, 
NAME(1) = 'oxygen'  , M(1) = 32 , SIGMA(1) = 3433, EPSOK(1) = 113 , 
NAME(2) = 'nitrogen', M(2) = 32 , SIGMA(2) = 3681, EPSOK(2) = 91.5 /

&GPYRO_GYIELDS 
GYIELDS(1,1) = 1, 
 /

&GPYRO_HGYIELDS 
 /

&GPYRO_CASES NCASES = 1, 
IMESH(1) = 1, TSTOP(1) = 10/

&GPYRO_IC NIC = 1, 
TMP_INITIAL(1) = 300, TMPG_INITIAL(1) = 300 , P_INITIAL(1) = 101300, YI0(1,1) = 1, YJ0(1,1) = 0  , YJ0(1,2) = 1,
/

&GPYRO_ALLBC NSURF_IDX = 2, 
SURF_IDX(1) = 1, T(1) = 0, QE(1) = 0, HC(1) = 0.  , TINF(1) = 300, RERADIATION(1) = .FALSE., YJINF(1,1) = 0.22, YJINF(1,2) = 0.78, MDOTPP(1)=10,
SURF_IDX(2) = 2, T(2) = 0, QE(2) = 0, HC(2) = 0   , TINF(2) = 300, RERADIATION(2) = .FALSE., YJINF(2,1) = 0.22 ,YJINF(2,2) = 0.78, MDOTPP(2)=0,/

&GPYRO_GEOM NMESH = 1, 
ZDIM(1) = 0.1, NCELLZ(1) = 500, NCELLY(1) = 1, NCELLX(1) = 1, 
DEFAULT_IC(1) = 1, DEFAULT_SURF_IDX(1,5) = 2, DEFAULT_SURF_IDX(1,6) = 1 /




