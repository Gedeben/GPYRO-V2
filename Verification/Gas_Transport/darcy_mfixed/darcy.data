//
&GPYRO_GENERAL 
DT0 = 1
SOLVE_PRESSURE = .TRUE.
GZ = 0
/ 

&GPYRO_OUTPUT 
CASENAME = 'darcy' ,
N_POINT_QUANTITIES = 1, N_PROFILE_QUANTITIES = 5,DTDUMP_POINT = 1,
POINT_QUANTITY(1) = 'MLR'  ,POINT_QUANTITY_INDEX(1) = 0,
PROFILE_QUANTITY(1) = 'PRESSURE'
PROFILE_QUANTITY(2) = 'QSG'
PROFILE_QUANTITY(3) = 'TEMPERATURE'
PROFILE_QUANTITY(4) = 'D12'
PROFILE_QUANTITY(5) = 'MASS_FLUX_TOTAL_Z'/ 

&GPYRO_SPROPS NSSPEC = 1,
NAME(1) = 'MAT_A', K0Z(1) = 0.2, R0(1) = 1000, RS0(1)=1500, C0(1) = 1800, EMIS(1) = 1, PERMZ(1)=5E-10 / 

&GPYRO_GPROPS NGSPEC = 1, CPG=0, IO2=1, IBG=1
NAME(1) = 'air' , M(1) = 29 , SIGMA(1)=3.617,  EPSOK(1)=97 /

&GPYRO_RXNS NRXNS = 0, 
/

&GPYRO_GYIELDS GYIELDS(1,1) = 1/

&GPYRO_CASES NCASES = 1, TSTOP(1) = 500 /

&GPYRO_IC NIC = 1, TMP_INITIAL(1) = 300, YI0(1,1) = 1,   YJ0(1,1) = 1, P_INITIAL(1) = 101300,/

&GPYRO_ALLBC NSURF_IDX = 2, 
SURF_IDX(1) = 1, T(1) = 0, QE(1) = 0, HC(1) = 0, TINF(1) = 300, RERADIATION(1) = .FALSE., YJINF(1,1) = 1,MDOTPP(1)=10000, PRES(1)=-1
SURF_IDX(2) = 2, T(2) = 0, QE(2) = 0, HC(2) = 0, TINF(2) = 300, RERADIATION(2) = .FALSE., YJINF(2,1) = 1,MDOTPP(2)=0,PRES(2)=101300/

&GPYRO_GEOM NMESH = 1, 
ZDIM(1) = 0.1, NCELLZ(1) = 1000, NCELLY(1) = 1, NCELLX(1) = 1, 
DEFAULT_IC(1) = 1, DEFAULT_SURF_IDX(1,5) = 2, DEFAULT_SURF_IDX(1,6) = 1 /

