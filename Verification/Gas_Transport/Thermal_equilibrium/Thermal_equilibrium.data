//
&GPYRO_GENERAL 
DT0 = 5/ 

&GPYRO_OUTPUT 
CASENAME = 'Thermal_equilibrium' ,
N_POINT_QUANTITIES = 0, N_PROFILE_QUANTITIES = 3,DTDUMP_POINT = 1,
PROFILE_QUANTITY(1) = 'MASS_FLUX_TOTAL_Z'
PROFILE_QUANTITY(2) = 'QSG'
PROFILE_QUANTITY(3) = 'TEMPERATURE'/ 

&GPYRO_SPROPS NSSPEC = 1,
NAME(1) = 'MAT_A', K0Z(1) = 2, R0(1) = 1000, C0(1) = 1800, EMIS(1) = 1 / 

&GPYRO_GPROPS NGSPEC = 1, NAME(1) = 'gas1', CPG=1000 /

&GPYRO_RXNS NRXNS = 1, 
CFROM(1) = 'MAT_A', CTO(1) = 'gases' TCRIT(1)=5000,, Z(1)= 1E+20 , E(1)= 200, ORDER(1) = 1, CHI(1)= 1/

&GPYRO_GYIELDS GYIELDS(1,1) = 1/

&GPYRO_CASES NCASES = 2,
IMESH(1)=1, TSTOP(1) = 2000
IMESH(2)=2, TSTOP(2) = 2000 /

&GPYRO_IC NIC = 1, TMP_INITIAL(1) = 300, YI0(1,1) = 1,   YJ0(1,1) = 1,/

&GPYRO_ALLBC NSURF_IDX = 3, 
SURF_IDX(1) = 1, T(1) = 0, QE(1) = 0, HC(1) = 0, TINF(1) = 300, TINFG(1) = 300, RERADIATION(1) = .FALSE., YJINF(1,1) = 1,MDOTPP(1)=100,
SURF_IDX(2) = 2, T(2) = 0, QE(2) = 50000, HC(2) = 0, TINF(2) = 300, RERADIATION(2) = .FALSE., YJINF(2,1) = 1,MDOTPP(2)=0,
SURF_IDX(3) = 3, T(3) = 0, QE(3) = 0    , HC(3) = 0, TINF(3) = 300, RERADIATION(3) = .FALSE., YJINF(3,1) = 1,MDOTPP(3)=0,
/

&GPYRO_GEOM NMESH = 2, 
ZDIM(1) = 0.1, NCELLZ(1) = 100, NCELLY(1) = 1, NCELLX(1) = 1, 
DEFAULT_IC(1) = 1, DEFAULT_SURF_IDX(1,5) = 2, DEFAULT_SURF_IDX(1,6) = 1 
ZDIM(2) = 0.1, NCELLZ(2) = 100, NCELLY(2) = 1, NCELLX(2) = 1, 
DEFAULT_IC(2) = 1, DEFAULT_SURF_IDX(2,5) = 2, DEFAULT_SURF_IDX(2,6) = 3 /
