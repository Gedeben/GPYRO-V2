//

&GPYRO_GENERAL 
DT0 = 0.5,
CONVENTIONAL_RXN_ORDER = .FALSE.,
CONSTANT_DHVOL=.TRUE.,
 / 

&GPYRO_OUTPUT 
CASENAME = 'sensible_enthalpy' ,
N_POINT_QUANTITIES = 5,
N_PROFILE_QUANTITIES = 0,

DTDUMP_POINT = 10,

POINT_QUANTITY(1) = 'TEMPERATURE', POINT_Z(1) = 0.001, 
POINT_QUANTITY(2) = 'MLR',  POINT_QUANTITY_INDEX(2) = 0, POINT_Z(3) = 0.001,
POINT_QUANTITY(3) = 'YI', POINT_QUANTITY_INDEX(3) = 1,
POINT_QUANTITY(4) = 'REACTION_RATE_K', POINT_QUANTITY_INDEX(4) = 1, POINT_Z(4) = 0.001,
POINT_QUANTITY(5) = 'QSC',POINT_Z(5) = 0.001,
 / 

&GPYRO_SPROPS NSSPEC = 2,
   NAME(1) = 'A' , K0Z(1) = 0.25, R0(1) = 1000, C0(1) = 1200, EMIS(1) = 1, 
   NAME(2) = 'B' , K0Z(2) = 0.25, R0(2) = 400, C0(2) = 1700, EMIS(2) = 1,
/ 

&GPYRO_GPROPS NGSPEC = 3, IO2 = 1,
  NAME(1) = 'O2',
  NAME(2) = 'PYROLYSATE',
  NAME(3) = 'NITROGEN', 
 /

&GPYRO_RXNS 
NRXNS = 1, 
CFROM(1) = 'A' ,
CTO(1)   = 'B' ,
Z(1)     =  1E+13 ,
E(1)     = 150 ,
ORDER(1) = 1 ,
CHI(1)   = 1 ,
DHS(1)	 = 0D0,
DHV(1)	 = 0D0,
/

&GPYRO_CASES NCASES = 1, 
IMESH(1) = 1, 
TSTOP(1) = 1000, 
ZEROD(1) = .FALSE., 
 /

&GPYRO_GYIELDS 
GYIELDS(1,1) = 0, 
GYIELDS(2,1) = 1, 
GYIELDS(3,1) = 0, 
 /
 
&GPYRO_IC NIC = 1, 
TMP_INITIAL(1) = 300, YI0(1,1) = 1
 /

&GPYRO_ALLBC NSURF_IDX = 2, 
SURF_IDX(1) = 1, T(1) = 0, QE(1) = 10000, HC(1) = 0, TINF(1) = 300, RERADIATION(1) = .TRUE., 
SURF_IDX(2) = 2, T(2) = 0, QE(2) = 0   , HC(2)  = 0, TINF(2) = 298, RERADIATION(2) = .FALSE.,  /

&GPYRO_GEOM 
NMESH = 1, NOBST = 0, 
ZDIM(1)   = 0.01, XDIM(1)   = 1, YDIM(1)   = 1, 
NCELLZ(1) = 50  , NCELLX(1) = 1, NCELLY(1) = 1, 
DEFAULT_SURF_IDX(1,5) = 1, 
DEFAULT_SURF_IDX(1,6) = 2, 
DEFAULT_IC(1) = 1, 
 /
