//

&GPYRO_GENERAL 
DT0 = 0.15,
CONVENTIONAL_RXN_ORDER = .FALSE.,
SOLVE_PRESSURE = .FALSE.
/ 


&GPYRO_OUTPUT 
CASENAME = 'Mixture_Law' ,
N_POINT_QUANTITIES = 11,
N_PROFILE_QUANTITIES = 0,

DTDUMP_POINT = 10,

POINT_QUANTITY(1) = 'TEMPERATURE', 
POINT_Z(1) = 0.0, POINT_X(1) = 0.0, POINT_Y(1) = 0.0, 

POINT_QUANTITY(2) = 'YI', 
POINT_QUANTITY_INDEX(2) = 1, 
POINT_Z(2) = 0.0, POINT_X(2) = 0.0, POINT_Y(2) = 0.0, 

POINT_QUANTITY(3) = 'YI',
POINT_QUANTITY_INDEX(3) = 2,
POINT_Z(3) = 0.0, POINT_X(3) = 0.0, POINT_Y(3) = 0.0, 

POINT_QUANTITY(4) = 'REACTION_RATE_K',
POINT_QUANTITY_INDEX(4) = 1,
POINT_Z(4) = 0.0, POINT_X(4) = 0.0, POINT_Y(4) = 0.0, 

POINT_QUANTITY(5) = 'THERMAL_CONDUCTIVITY_Z', 
POINT_Z(5) = 0.0, POINT_X(5) = 0.0, POINT_Y(5) = 0.0, 

POINT_QUANTITY(6) = 'SPECIFIC_HEAT_CAPACITY', 
POINT_Z(6) = 0.0, POINT_X(6) = 0.0, POINT_Y(6) = 0.0, 

POINT_QUANTITY(7) = 'SOLID_DENSITY', 
POINT_Z(7) = 0.0, POINT_X(7) = 0.0, POINT_Y(7) = 0.0, 

POINT_QUANTITY(8) = 'BULK_DENSITY', 
POINT_Z(8) = 0.0, POINT_X(8) = 0.0, POINT_Y(8) = 0.0, 

POINT_QUANTITY(9) = 'POROSITY', 
POINT_Z(9) = 0.0, POINT_X(9) = 0.0, POINT_Y(9) = 0.0, 

POINT_QUANTITY(10) = 'XI', 
POINT_QUANTITY_INDEX(10) = 1,
POINT_Z(10) = 0.0, POINT_X(10) = 0.0, POINT_Y(10) = 0.0, 

POINT_QUANTITY(11) = 'XI',
POINT_QUANTITY_INDEX(11) = 2,
POINT_Z(11) = 0.0, POINT_X(11) = 0.0, POINT_Y(11) = 0.0, 
/ 

&GPYRO_SPROPS NSSPEC = 2,

NAME(1) = 'MAT_A',
K0Z(1) = 1, K0X(1) = 0.5, K0Y(1) = 0.7, GAMMA(1) = 0,
R0(1) = 1000, RS0(1) = 2000,
C0(1) = 1200,
EMIS(1) = 1,
PERMZ(1)=10E-12,

NAME(2) = 'MAT_B',
K0Z(2) = 0.5,K0X(2) = 1,K0Y(2) = 0.2, GAMMA(2) = 0,
R0(2) = 600, RS0(2) = 800,
C0(2) = 1900,
EMIS(2) = 0,
PERMZ(2)=1E-12
/ 

&GPYRO_GPROPS NGSPEC = 1,
   IBG=1,  IO2=1
  NAME(1) = 'air' , M(1) = 29 , SIGMA(1)=3.617,  EPSOK(1)=97 /
 /

&GPYRO_RXNS 
NRXNS = 1, 
CFROM(1) = 'MAT_A' ,
CTO(1)   = 'MAT_B' ,
Z(1)     =  0.001 ,
E(1)     = 0,
ORDER(1) = 0,
CHI(1)   = 0,
/



&GPYRO_GYIELDS 
GYIELDS(1,1) = 1, 
 /


&GPYRO_CASES NCASES = 1, 
IMESH(1) = 1, 
TSTOP(1) = 1500, 
ZEROD(1) = .FALSE., 
 /


&GPYRO_IC 
NIC = 1, 
TMP_INITIAL(1) = 10000, 
TMPG_INITIAL(1) = 10000, 
P_INITIAL(1) = 101300, 
YI0(1,1) = 1,   
YJ0(1,1) = 1,
/

&GPYRO_ALLBC 
NSURF_IDX = 1, 

SURF_IDX(1) = 1, 
T(1) = 0, 
QE(1) = 0, 
HC(1) = 0, 
TINF(1) = 2000, 
MDOTPP(1)=0,
PRES(1)=101300
RERADIATION(1) = .FALSE., 
YJINF(1,1) = 1,


/

&GPYRO_GEOM 
NMESH = 1, 
ZDIM(1) = 1,YDIM(1) = 1,XDIM(1) = 1,
NCELLZ(1) = 3,
NCELLY(1) = 1, 
NCELLX(1) = 1, 
DEFAULT_IC(1) = 1, 
DEFAULT_SURF_IDX(1,1) = 1, 
DEFAULT_SURF_IDX(1,2) = 1, 
DEFAULT_SURF_IDX(1,3) = 1, 
DEFAULT_SURF_IDX(1,4) = 1, 
DEFAULT_SURF_IDX(1,5) = 1, 
DEFAULT_SURF_IDX(1,6) = 1, 
 /

