&HEAD CHID='radiation_loss', TITLE='Heat Transfer through solid Slab' /

&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0.0,0.3 /

&TIME T_END=18000., WALL_INCREMENT=1, DT=10. /

&MISC  SOLID_PHASE_ONLY=.TRUE.
	TMPA=-273.15,
	RADIATION= .TRUE./ 

&SURF ID        = 'SLAB'
      MATL_ID   = 'SLAB_A'
      THICKNESS = 0.04
      CELL_SIZE_FACTOR = 0.5
      STRETCH_FACTOR = 1.,
      TMP_INNER=227,
      HEAT_TRANSFER_COEFFICIENT  = 0.
      EXTERNAL_FLUX		= 0,
      BACKING   = 'INSULATED' /

&MATL ID            = 'SLAB_A'
      CONDUCTIVITY  = 0.186
      EMISSIVITY    = 1.
      SPECIFIC_HEAT = 1.764,
      DENSITY       = 380. /

&OBST XB = -0.05,0.05,-0.05,0.05,0.1,0.14, SURF_IDS='SLAB', 'INERT', 'INERT' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /


&DEVC XYZ = 0.0,0.0,0.1, IOR = 3, ID='Front',  QUANTITY = 'WALL TEMPERATURE', TIME_AVERAGED=.FALSE. /
&DEVC XYZ = 0.0,0.0,0.14, IOR = 3, ID='Back',  QUANTITY = 'BACK WALL TEMPERATURE', TIME_AVERAGED=.FALSE. /
&DEVC XYZ = 0.0,0.0,0.25, ID='gaz_temp',  QUANTITY = 'TEMPERATURE', TIME_AVERAGED=.FALSE. /
&TAIL /











