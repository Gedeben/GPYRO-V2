&HEAD CHID='1d_rad_conv', TITLE='Heat Transfer through solid Slab' /

&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0.0,0.3 /

&TIME T_END=7500., WALL_INCREMENT=1, DT=10. /

&MISC  SOLID_PHASE_ONLY=.TRUE.,
	TMPA=25.,
	RADIATION=.TRUE. / 

&SURF ID        = 'SLAB'
      MATL_ID   = 'SLAB_A'
      THICKNESS = 0.1
      CELL_SIZE_FACTOR = 3.2
      STRETCH_FACTOR = 1.
      HEAT_TRANSFER_COEFFICIENT  = 10.
      EXTERNAL_FLUX		= 1,
      TMP_INNER=25,
      BACKING   = 'INSULATED' /

&MATL ID            = 'SLAB_A'
      CONDUCTIVITY  = 0.15
      EMISSIVITY    = 0.86
      SPECIFIC_HEAT = 1.34
      DENSITY       = 605.
      ABSORPTION_COEFFICIENT = 500000000000 /

&OBST XB = -0.05,0.05,-0.05,0.05,0.1,0.2, SURF_IDS='SLAB', 'INERT', 'INERT' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /


&DEVC XYZ = 0.0,0.0,0.15, IOR = 3, ID='Tz0mm',  QUANTITY = 'WALL TEMPERATURE', TIME_AVERAGED=.FALSE. /
&DEVC XYZ = 0.0,0.0,0.15, IOR = 3, ID='Tz100mm',  QUANTITY = 'BACK WALL TEMPERATURE', TIME_AVERAGED=.FALSE. /
&DEVC XYZ=0.0,0.0,0.15, DEPTH=0.05, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE',     ID='Tz50mm' /
&DEVC XYZ=0.0,0.0,0.15, DEPTH=0.075, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE',     ID='Tz75mm' /

&TAIL /











