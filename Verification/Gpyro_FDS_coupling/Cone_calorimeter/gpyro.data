 / 

  
&GPYRO_OUTPUT 
CASENAME = 'Simple_pyrolyse',
N_POINT_QUANTITIES = 3,
N_PROFILE_QUANTITIES = 1,
N_SMOKEVIEW_QUANTITIES = 0,
DTDUMP_GA = 1,
DTDUMP_POINT = 1,
DTDUMP_PROFILE = 1,
DTDUMP_SMOKEVIEW = 1,

POINT_QUANTITY(1) = 'MLR', POINT_QUANTITY_INDEX(1) = 0, POINT_Z(1) = 0, POINT_X(1) = 0, POINT_Y(1) = 0, 
POINT_QUANTITY(2) = 'TEMPERATURE', POINT_Z(2) = 0    , POINT_X(2) = 0, POINT_Y(2) = 0, 
POINT_QUANTITY(3) = 'TEMPERATURE', POINT_Z(3) = 0.005, POINT_X(3) = 0, POINT_Y(3) = 0, 
POINT_QUANTITY(3) = 'THICKNESS',   POINT_Z(3) = 0    , POINT_X(3) = 0, POINT_Y(3) = 0, 

PROFILE_QUANTITY(1) = 'TEMPERATURE', PROFILE_DIRECTION(1) = 'z', PROFILE_COORD1(1) = 0, PROFILE_COORD2(1) = 0, PROFILE_ISKIP(1) = 1, 
/
 
&GPYRO_SPROPS NSSPEC = 2, 
NAME(1) = 'virgin'      , K0Z(1) = 0.3, K0X(1) = 0.3, K0Y(1) = 0.3, R0(1) = 1000, C0(1) = 1000, EMIS(1) = 0.9, KAPPA(1) = 9D9,
NAME(2) = 'intermediate', K0Z(2) = 0.3, K0X(2) = 0.3, K0Y(2) = 0.3, R0(2) = 1000, C0(2) = 1000, EMIS(2) = 0.9, KAPPA(2) = 9D9,
 / 
 
&GPYRO_RXNS NRXNS = 2, 
CFROM(1) = 'virgin' , CTO(1) = 'intermediate', Z(1) =  1.5E+9 , E(1) = 120 , DHS(1) = 0, DHV(1) = 0 , CHI(1) = 0 ,ORDER(1) = 1 ,IKINETICMODEL(1) = 0 ,
CFROM(2) = 'virgin' , CTO(2) = 'gases'       , Z(2) =  0.5E+9 , E(2) = 120 , DHS(2) = 0, DHV(2) = 0 , CHI(2) = 1 ,ORDER(2) = 1 ,IKINETICMODEL(2) = 0 , /


&GPYRO_HGRXNS 
NHGRXNS = 0, 
 /

&GPYRO_GPROPS NGSPEC = 1, 
NAME(1) = 'gas1' /

&GPYRO_GYIELDS 
