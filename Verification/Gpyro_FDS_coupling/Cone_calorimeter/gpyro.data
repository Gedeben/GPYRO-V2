&GPYRO_ALLBC NSURF_IDX = 2 
SURF_IDX(1) = 1, QE(1) = 50000, HC(1) = 10, TINF(1) = 293.15, RERADIATION(1) = .TRUE. , YJINF(1,1) = 1,
SURF_IDX(2) = 2, QE(2) = 0    , HC(2) = 0 , TINF(2) = 293.15, RERADIATION(2) = .FALSE., YJINF(2,1) = 1, /

&GPYRO_GEOM NMESH = 1, NOBST = 0, 
NCELLZ(1) = 50, NCELLX(1) = 10, NCELLY(1) = 10, ZDIM(1) = 0.005,  XDIM(1) = 0.20, YDIM(1) = 0.20, 
DEFAULT_SURF_IDX(1,1) = 2, 
DEFAULT_SURF_IDX(1,2) = 2, 
DEFAULT_SURF_IDX(1,3) = 2, 
DEFAULT_SURF_IDX(1,4) = 2, 
