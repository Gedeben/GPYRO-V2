//
&GPYRO_GENERAL 
DT0 = 0.5,
TAMB = 300,
TREF = 300,
NTDMA_ITERATIONS = 1000,
NSSPECIESITERNS = 1000,
NCONTINUITYITERNS = 1000,
DUMP_DETAILED_CONVERGENCE = .TRUE.,
ALPHA = 0.5,
TMPTOL = 0.001,
HTOL = 0.001,
YITOL = 0.001,
PTOL = 0.01,
YJTOL = 0.1,
SOLVE_GAS_YJ = .FALSE.,
SOLVE_GAS_ENERGY = .FALSE.,
SOLVE_PRESSURE = .FALSE.,
USE_TOFH_NEWTON = .TRUE.,
SHYI_CORRECTION = .TRUE.,
NCOEFF_UPDATE_SKIP = 1,
 / 

&GPYRO_OUTPUT 
CASENAME = 'gpyro',
N_POINT_QUANTITIES = 2,
N_PROFILE_QUANTITIES = 1,
N_SMOKEVIEW_QUANTITIES = 6,

DTDUMP_POINT = 0.5,
DTDUMP_PROFILE = 1,
DTDUMP_SMOKEVIEW = 1,



POINT_QUANTITY(1) = 'TEMPERATURE', POINT_Z(1) = 0.02, POINT_X(1) = 0.01, POINT_Y(1) = 0.01, 
POINT_QUANTITY(2) = 'TEMPERATURE', POINT_Z(2) = 0.0 , POINT_X(2) = 0.01, POINT_Y(2) = 0.01, 

PROFILE_QUANTITY(1) = 'TEMPERATURE', PROFILE_DIRECTION(1) = 'z', PROFILE_COORD1(1) = 0.01, PROFILE_COORD2(1) = 0.01, PROFILE_ISKIP(1) = 1,  


SMOKEVIEW_QUANTITY(1) = 'TEMPERATURE', SMOKEVIEW_PLANE(1)='xz', SMOKEVIEW_LOCATION(1)=0.0,
SMOKEVIEW_QUANTITY(2) = 'TEMPERATURE', SMOKEVIEW_PLANE(2)='xz', SMOKEVIEW_LOCATION(2)=0.2,
SMOKEVIEW_QUANTITY(3) = 'TEMPERATURE', SMOKEVIEW_PLANE(3)='yz', SMOKEVIEW_LOCATION(3)=0.0,
SMOKEVIEW_QUANTITY(4) = 'TEMPERATURE', SMOKEVIEW_PLANE(4)='yz', SMOKEVIEW_LOCATION(4)=0.2,
SMOKEVIEW_QUANTITY(5) = 'TEMPERATURE', SMOKEVIEW_PLANE(5)='xy', SMOKEVIEW_LOCATION(5)=0.0,
SMOKEVIEW_QUANTITY(6) = 'TEMPERATURE', SMOKEVIEW_PLANE(6)='xy', SMOKEVIEW_LOCATION(6)=0.2,/ 

 
&GPYRO_SPROPS NSSPEC = 1, 
NAME(1) = 'slab', K0Z(1) = 5, K0X(1) = 5, K0Y(1) = 5, R0(1) = 1000, C0(1) = 100, EMIS(1) = 1.0, KAPPA(1) = 9D9 / 

&GPYRO_RXNS NRXNS = 0 /


&GPYRO_GPROPS NGSPEC = 1,
NAME(1) = 'AIR' /

&GPYRO_GYIELDS /

&GPYRO_HGYIELDS /

&GPYRO_CASES NCASES = 1, 
IMESH(1) = 1, TSTOP(1) = 300, ZEROD(1) = .FALSE.,  /

&GPYRO_IC NIC = 1, 
TMP_INITIAL(1) = 293.15, YI0(1,1) = 1, YJ0(1,1) = 1 /

&GPYRO_ALLBC NSURF_IDX = 1, 
SURF_IDX(1) = 1, QE(1) = 0, HC(1) = 0, TINF(1) = 293.15, RERADIATION(1) =.TRUE., TFIXED(1) = -1,YJINF(1,1) = 1, /

&GPYRO_GEOM NMESH = 1, NOBST = 0, 
ZDIM(1) = 0.2, XDIM(1) = 0.2, YDIM(1) = 0.2, 
NCELLZ(1) = 16, NCELLX(1) = 16, NCELLY(1) = 16, 
DEFAULT_SURF_IDX(1,1) = 1, 
DEFAULT_SURF_IDX(1,2) = 1, 
DEFAULT_SURF_IDX(1,3) = 1, 
DEFAULT_SURF_IDX(1,4) = 1, 
DEFAULT_SURF_IDX(1,5) = 1, 
DEFAULT_SURF_IDX(1,6) = 1, 
DEFAULT_IC(1) = 1,  
 /

